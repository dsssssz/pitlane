// PITLANE GPS — габариты деталей (мм). Источники — в README.md, раздел «Размеры деталей».
// Значения с пометкой [ДОП] — не из даташита, а конструктивный запас/допущение: померьте свою деталь.

// GNSS: GY-GPSV3-M9N (u-blox NEO-M9N), плата 25x35, патч 25x25 на плате
GPS_L      = 36;    // длина платы: 35 по продавцам, 36 по TinyTronics — заложено 36
GPS_W      = 25;    // ширина платы
GPS_PCB    = 1.6;   // [ДОП] стандартная толщина FR-4
GPS_UNDER  = 3.0;   // [ДОП] детали снизу: NEO-M9N 2.4 (max 2.6 по даташиту u-blox) + запас
GPS_UNDER_INSET = 2.0; // [ДОП] полоса у длинных краёв без деталей снизу (на неё опирается плата)
GPS_PATCH_H = 4.0;  // патч 25x25x4 (типоразмер, напр. Taoglas CGGP.25.4); в модели — огибающая на всю плату
GPS_TOP_A  = 2.5;   // [ДОП] вариант A (без патча, с U.FL): высота деталей сверху

// ESP32-C3 SuperMini
ESP_L   = 22.52;
ESP_W   = 18;
ESP_PCB = 1.0;      // [ДОП]
ESP_H   = 4.3;      // [ДОП] плата + USB-C 3.26
ESP_USB_OVER = 1.5; // по сводкам ~24 мм с разъёмом против 22.52 мм платы

// TP4056 USB-C (с DW01A+FS8205A)
TP_L   = 26;
TP_W   = 17;
TP_PCB = 1.0;       // [ДОП]
TP_H   = 4.3;       // ~4 мм по продавцу, взято 1.0 + 3.26 (разъём)
USBC   = [8.94, 7.35, 3.26]; // [ДОП] типовой корпус гнезда USB-C 16P (ш x гл x в)
TP_USB_OVER = 1.5;  // [ДОП] вынос гнезда за край платы
USB_PLUG_CUT = [12.4, 6.6, 2]; // окно под корпус вилки USB-C (ш, в, радиус)

// Аккумуляторы (с платой защиты: +2 мм по длине)
BAT_BOX  = [50+2, 34, 10];   // 103450
BAT_PUCK = [40+2, 30, 8];    // 803040, 1000 мА·ч

// SS12D00G4
SW_L = 8.8;  SW_W = 3.9;  SW_D = 7.2;   // корпус+выводы (Sofng SS-12D00: L8.8 x W3.9 x H7.2)
SW_LEVER = 4.0;          // G4 = рычаг 4 мм
SW_TRAVEL = 3.5;         // ход движка (voltiq); у части продавцов 2.0
SW_LEVER_SEC = 2.0;      // [ДОП] сечение рычага, <= 2x2 мм

// SMA-гнездо на панель (bulkhead), 1/4"-36
SMA_HOLE = 6.5;   // Würth 65503503230501: вырез Ø6.5
SMA_FLAT = 6.0;   //   с лыской 6.0
SMA_PANEL_MAX = 2.8; // макс. толщина панели
SMA_NUT_D = 8/cos(30); // гайка 8 мм под ключ -> 9.24 по углам
SMA_IN = 11;      // [ДОП] огибающая гайка+корпус+пигтейл внутри

// Светодиоды
LED_D = 3.8; LED_H = 5.3;  // 3-мм светодиод (буртик Ø3.8)
STRIP_W = 5; STRIP_T = 1.6; // лента <=5 мм (напр. WS2812B-2020 5 мм) [ДОП]

// Крепёж
M2_PILOT = 1.6;  // отверстие под саморез M2 / винт M2 в пластик
M2_CLR   = 2.4;
M2_CSK   = 4.0;  // потай DIN 965 M2: головка Ø3.8

// ---------- болванки ----------
// g = раздувание (для проверки зазора); nb = не раздувать вниз (деталь лежит на опоре)
module gbox(p0, s, g=0, nb=true) {
  translate([p0.x-g, p0.y-g, p0.z-(nb?0:g)]) cube([s.x+2*g, s.y+2*g, s.z+g+(nb?0:g)]);
}
module gcyl_z(c, d, z0, h, g=0, nb=true) {
  translate([c.x, c.y, z0-(nb?0:g)]) cylinder(d=d+2*g, h=h+g+(nb?0:g), $fn=40);
}
